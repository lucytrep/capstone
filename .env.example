EXPO_PUBLIC_ANTHROPIC_API_KEY=
EXPO_PUBLIC_PEXELS_API_KEY=
EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=
EXPO_PUBLIC_GEMINI_API_KEY=
# Pinterest service — run `python pinterest-service/server.py` locally, then set this
EXPO_PUBLIC_PINTEREST_SERVICE_URL=http://localhost:8765
# Cosmos visual search — get key at cosmos.so/api after creating an account
EXPO_PUBLIC_COSMOS_API_KEY=
# Are.na: no API key required for public read
# Pinterest session cookie — copy from browser DevTools (Network tab, any pinterest.com request)
PINTEREST_SESSION_COOKIE=
